# Copy from .env.local on the Vercel dashboard
# https://nextjs.org/learn/dashboard-app/setting-up-your-database#create-a-postgres-database
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_USER=
POSTGRES_HOST=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=http://localhost:3000/api/auth

# Notion Integration
NOTION_ACCESS_TOKEN=
NOTION_BLOG_DATABASE_ID=
NOTION_BLOG_DATASOURCE_ID=

# Optional Draft Preview Master Secret
# Allows master access to preview any draft article via ?preview=<secret> or ?token=<secret>
DRAFT_SECRET=